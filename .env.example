DEBUG=True
DJANGO_SECRET_KEY=your-dev-secret-key
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://swift_user:your_password@localhost:5432/swift_delivery
# Windows only; change this if PostgreSQL/PostGIS is installed elsewhere.
POSTGIS_BIN_PATH=C:\PostgreSQL\18\bin
GOOGLE_MAPS_API_KEY=your-google-maps-server-key
REMOVE_BG_API_KEY=your-remove-bg-server-key
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
USE_CLOUDINARY=False
CLOUDINARY_FOLDER=swift-delivery/development
DJANGO_ADMIN_SETUP_ENABLED=False
DJANGO_ADMIN_USERNAME=
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=
DEPLOYMENT_ENVIRONMENT=development
DJANGO_CATALOG_IMPORT_ENABLED=False
GOOGLE_MAPS_ADMIN_BROWSER_API_KEY=your-browser-key
